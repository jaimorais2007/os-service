    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>3dbfac4b-2946-4216-9046-3e2da55731ff</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
